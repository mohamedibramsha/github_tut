#% text_encoding = iso8859_1
$
_block
	##Added changes in github editor
	write("++++++++++++++ 2nd set Substation HFL Update Started ++++++++++++++++++++++++++")
	l_sub << v(:electric).collection(:sub_substation)
	sub_id << rope.new_with(49207917,111218894,49994251,57010392,46866724,105418737,47595081,49205109,57068684,49522799,49991707,49954168,49744094,80465266,49953280,47861576,57959234,49387774,48438406,46867621,48859494,48681144,49290612,47693691,49651139,49405764,49993949,46856332,50072430,49464165,48860593,114168872,50204303,48440021,47183857,47495384,57198613,47296091,48770443,57956275,51242838,48269475,50435138,49524559,50515779,48942157,48515597,50334785,46945390,57673714,51036891)	
	rp_rec << rope.new()
	pl << property_list.new_with(:cgis_hfl_value,"FL > 25kA")
	_for i _over sub_id.fast_elements() 
	_loop
		rp_rec.add(record_transaction.new_update(l_sub.at(i),pl))
	_endloop
	dataset_transaction.new(rp_rec).run()

	write("++++++++++++++ 2nd set Substation HFL Update Completed  ++++++++++++++++++++++++++")
_endblock
